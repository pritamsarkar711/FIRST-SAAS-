# ──────────────────────────────────────────────────────────────
# Audit Form — environment template
# Copy to .env and fill in. Never commit the real .env.
# ──────────────────────────────────────────────────────────────

# Database (pick ONE; on Hostinger use MySQL)
# MySQL / MariaDB (Hostinger hPanel → Databases → MySQL):
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@mysql-host.hostinger.com:3306/DB_NAME"
# Local development (SQLite — also copy prisma/schema.prisma):
# DATABASE_URL="file:./db/custom.db"

# NextAuth — generate a strong random string:
#   openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Tells NextAuth v4 to trust the Host/proxy headers Hostinger sends.
# Do NOT set NEXTAUTH_URL to a hardcoded value; with AUTH_TRUST_HOST=true
# the origin is derived per request (a hardcoded localhost URL caused
# ERR_TOO_MANY_REDIRECTS behind the preview proxy).
AUTH_TRUST_HOST="true"

# Public site URL used for canonical links, sitemap.xml, OG tags and the
# docs page. Set this to your real domain in production:
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# First-run admin account (seeded automatically on first request).
# CHANGE the password or set a strong one here before going live.
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-me-strong-password"

# Google OAuth (optional — Sign in with Google appears only when set).
# Create at https://console.cloud.google.com → OAuth consent + credentials.
# Authorized redirect URI: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Notes:
# - OpenRouter AI, SMTP mail, payment gateways and credit costs are all
#   configured from the admin panel (/manage/settings), not from env.
# - The sandbox z-ai fallback only exists in this workspace; on Hostinger
#   add a real OpenRouter key in /manage/settings.
