DATABASE_URL=file:/home/z/my-project/db/custom.db
NEXTAUTH_SECRET=adaudit-dev-secret-change-in-production
AUTH_TRUST_HOST=true
# NEXTAUTH_URL intentionally omitted. With AUTH_TRUST_HOST=true, NextAuth v4
# derives the base URL from X-Forwarded-Host/Proto. A hardcoded localhost URL
# caused a redirect loop (ERR_TOO_MANY_REDIRECTS) in the sandbox preview.
